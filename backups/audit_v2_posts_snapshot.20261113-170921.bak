  {
    "id": "1231786852860027608",
    "title": "Takht-i-Bahi — The Throne of the Spring | Takht-i-Bahi, Pakistan — The Buddhist Monastery on the Hilltop",
    "url": "https://dustanddynasty.blogspot.com/2011/08/heritage-takht-i-bahi-pakistan-buddhist-monastery-ruins-unesco.html",
